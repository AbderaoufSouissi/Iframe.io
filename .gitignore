# ============================================================
# 🌱 Global ignores
# ============================================================
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo
*.bak
*.orig

# ============================================================
# 🧩 Backend (Spring Boot)
# ============================================================
backend/target/
backend/.idea/
backend/.classpath
backend/.project
backend/.settings/
backend/.vscode/
backend/.apt_generated/
backend/.factorypath
backend/.gradle/
backend/build/

# Maven wrapper files (these can be safely regenerated)
backend/mvnw
backend/mvnw.cmd
backend/.mvn/wrapper/maven-wrapper.jar

# Local environment / config files
backend/src/main/resources/application-dev.yml
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-test.yml

# Test reports / temporary files
backend/test-output/
backend/surefire-reports/

# IntelliJ / Eclipse / VSCode
*.iml
*.ipr
*.iws

# ============================================================
# ⚛️ Frontend (React / Vite)
# ============================================================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# NPM/Yarn/PNPM logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Lock files (optional to ignore)
# frontend/package-lock.json
# frontend/yarn.lock

# ============================================================
# 🐳 Docker / Misc
# ============================================================
/docker-compose.override.yml
*.pid
*.seed

# ============================================================
# 🧠 OS / Editor files
# ============================================================
.vscode/
.idea/
*.bak
*.tmp
*.orig
